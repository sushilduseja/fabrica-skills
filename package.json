{
  "name": "fabrica-skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agent-readable markdown skills for turning raw product ideas into small working apps",
  "scripts": {
    "validate:run": "node scripts/validate-run.mjs",
    "validate:manifest": "node scripts/sync-manifest.mjs --check",
    "validate:run-pass": "node scripts/validate-run.mjs test/fixtures/valid-run.json",
    "validate:run-fail": "node scripts/_assert-invalid.mjs test/fixtures/invalid-run.json /status /app_stages/0/quality_score",
    "validate:run-gate-fail": "node scripts/_assert-invalid.mjs test/fixtures/invalid-gate-keys.json /gate_levels",
    "validate": "npm run validate:run-pass && npm run validate:run-fail && npm run validate:run-gate-fail && npm run validate:manifest",
    "test": "node test/run-tests.mjs",
    "setup": "npm run validate && node scripts/link-skills.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  }
}



