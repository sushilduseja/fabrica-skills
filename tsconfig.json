{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bin/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "test"]
}
