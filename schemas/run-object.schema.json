{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fabrica.run.json",
  "description": "Durable state file for one fabrica-skills run",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "experiment_phase",
    "created_at",
    "updated_at",
    "status",
    "current_step",
    "current_app_stage",
    "next_action",
    "last_error",
    "spec_path",
    "blueprint_path",
    "app_stages",
    "costs",
    "verifications",
    "human_decisions",
    "gate_levels",
    "preferred_stack"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[._-]|$))[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$"
    },
    "experiment_phase": {
      "type": "string",
      "enum": [
        "phase_0_spec",
        "phase_1_slice",
        "phase_2_pipeline"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "designing",
        "framing",
        "forging",
        "checking",
        "weaving",
        "verifying",
        "complete",
        "blocked",
        "abandoned"
      ]
    },
    "current_step": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "fab-spec",
            "fab-plan",
            "fab-scaffold",
            "fab-build",
            "fab-eval",
            "fab-status",
            "fab-handoff",
            "fab-fix",
            "fab-integrate",
            "fab-verify",
            "fab-decide",
            "fab-pr-review",
            "fab-retro",
            "fabrica-code-review"
          ]
        }
      ]
    },
    "current_app_stage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[._-]|$))[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
        }
      ]
    },
    "next_action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^/fab-[a-z0-9-]+( (?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[._-]|$))[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?)?$"
        }
      ]
    },
    "last_error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "missing_input",
                "invalid_state",
                "gate_blocked",
                "validation_failed",
                "prerequisite_missing",
                "external_failure"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "spec_path": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^docs/[A-Za-z0-9._/-]+\\.md$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "blueprint_path": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^docs/[A-Za-z0-9._/-]+\\.md$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "app_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "status",
          "quality_score",
          "artifacts",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[._-]|$))[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "done",
              "blocked",
              "failed"
            ]
          },
          "quality_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    },
    "costs": {
      "type": "object",
      "required": [
        "precision",
        "tokens_in",
        "tokens_out",
        "api_calls",
        "estimated_usd",
        "budget_usd",
        "by_step"
      ],
      "properties": {
        "precision": {
          "type": "string",
          "enum": [
            "unknown",
            "estimated",
            "measured"
          ]
        },
        "tokens_in": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "tokens_out": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "api_calls": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "estimated_usd": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "by_step": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "precision",
              "tokens_in",
              "tokens_out",
              "usd"
            ],
            "properties": {
              "precision": {
                "type": "string",
                "enum": [
                  "unknown",
                  "estimated",
                  "measured"
                ]
              },
              "tokens_in": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ]
              },
              "tokens_out": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ]
              },
              "usd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "command",
          "passed",
          "summary",
          "timestamp"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "local_launch",
              "external_deploy",
              "container_build",
              "static_analysis"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "passed": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "human_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "decision_needed",
          "options",
          "decision",
          "rationale",
          "triggered_at",
          "resolved_at"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "decision_needed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1
          },
          "decision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "triggered_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "gate_levels": {
      "type": "object",
      "required": [
        "fab-spec",
        "fab-plan",
        "fab-scaffold",
        "fab-build",
        "fab-eval",
        "fab-status",
        "fab-handoff",
        "fab-fix",
        "fab-integrate",
        "fab-verify",
        "fab-decide",
        "fab-pr-review",
        "fab-retro",
        "fabrica-code-review"
      ],
      "propertyNames": {
        "enum": [
          "fab-spec",
          "fab-plan",
          "fab-scaffold",
          "fab-build",
          "fab-eval",
          "fab-status",
          "fab-handoff",
          "fab-fix",
          "fab-integrate",
          "fab-verify",
          "fab-decide",
          "fab-pr-review",
          "fab-retro",
          "fabrica-code-review"
        ]
      },
      "properties": {
        "fab-status": {
          "const": "auto"
        },
        "fab-verify": {
          "const": "review"
        },
        "fab-decide": {
          "const": "full"
        },
        "fab-pr-review": {
          "const": "auto"
        }
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "auto",
          "checkpoint",
          "review",
          "full"
        ]
      }
    },
    "preferred_stack": {
      "type": "object",
      "properties": {
        "frontend": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "frontend",
        "backend",
        "database"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
